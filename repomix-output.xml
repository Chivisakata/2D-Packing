            <option value="Ellipse">Ellipse</option>
          </select>
          <div class="param-fields">
            <input type="number" class="param-1" placeholder="Width" value="100.5" style="width: 70px;">
            <input type="number" class="param-2" placeholder="Height" value="50.0" style="width: 70px;">
          </div>
          <input type="number" class="input-qty part-qty" placeholder="SL" value="1" title="Số lượng">
          <button class="btn-del" onclick="removeItemRow(this, 'partsList')">×</button>
        </div>

        <!-- Hàng 2: Circle -->
        <div class="item-row part-input-item">
          <select class="input-shape" onchange="changeShapeInputs(this)">
            <option value="Rectangle">Rectangle</option>
            <option value="Circle" selected>Circle</option>
            <option value="RightAngledTriangle">RightAngledTriangle</option>
            <option value="IsoscelesTriangle">IsoscelesTriangle</option>
            <option value="RegularHexagon">RegularHexagon</option>
            <option value="Ellipse">Ellipse</option>
          </select>
          <div class="param-fields">
            <input type="number" class="param-1" placeholder="Radius" value="25.0" style="width: 80px;">
          </div>
          <input type="number" class="input-qty part-qty" placeholder="SL" value="1" title="Số lượng">
          <button class="btn-del" onclick="removeItemRow(this, 'partsList')">×</button>
