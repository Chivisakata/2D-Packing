<body>

  <h2>📐 Mô phỏng sơ đồ cắt tấm (2D Packing Layout)</h2>

  <div class="container">
    <!-- CỘT NHẬP LIỆU -->
    <div class="panel">
      <h3 style="margin: 0 0 10px 0;">Thông số bài toán</h3>

      <!-- 1. Danh sách phôi nguyên (Stock Sheets) -->
      <div class="section-title">1. Danh sách phôi (Rộng × Cao | SL)</div>
