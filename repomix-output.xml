/* ==========================================
   CHÂN TRANG (FOOTER)
   ========================================== */
.site-footer {
  background-color: #ffffff;
  border-top: 1px solid #e2e8f0;
  color: #475569;
  font-family: 'Roboto', sans-serif;
  padding: 3.5rem 2rem;
  margin-top: auto;
}

.footer-container {
  max-width: 1700px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-col h3 {
  font-size: 1.25rem;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 0.5rem;
}

.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.footer-col a {
  color: #475569;
  text-decoration: none;
  font-size: 1.125rem;
  transition: color 0.15s ease;
}

.footer-col a:hover {
  color: #0f172a;
}

.footer-copyright {
  color: #94a3b8;
  font-size: 1rem;
  font-weight: 500;
  padding-top: 0.5rem;
}

@media (max-width: 1024px) {
  .footer-container {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .footer-container {
    grid-template-columns: 1fr;
  }
  .seo-section {
    padding: 1.5rem;
  }
}
