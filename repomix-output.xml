  <script>
    // 1. Thêm tấm phôi
    function addSheetRow() {
      const container = document.getElementById("sheetsList");
      const row = document.createElement("div");
      row.className = "item-row sheet-input-item";
      row.innerHTML = `
        <input type="number" class="input-w sheet-w" placeholder="Rộng" value="1000">
        <input type="number" class="input-h sheet-h" placeholder="Cao" value="2000">
        <input type="number" class="input-qty sheet-qty" placeholder="SL" value="1" title="Số lượng tấm">
        <button class="btn-del" onclick="removeItemRow(this, 'sheetsList')">×</button>
      `;
      container.appendChild(row);
    }

    // 2. Tự động đổi ô nhập liệu dựa trên hình khối
    function changeShapeInputs(selectElem) {
      const row = selectElem.closest(".part-input-item");
      const container = row.querySelector(".param-fields");
      const shape = selectElem.value;

      let html = "";
      switch (shape) {
        case "Rectangle":
          html = `
            <input type="number" class="param-1" placeholder="Width" value="100" style="width: 70px;">
            <input type="number" class="param-2" placeholder="Height" value="50" style="width: 70px;">
          `;
          break;
        case "Circle":
          html = `<input type="number" class="param-1" placeholder="Radius" value="25" style="width: 80px;">`;
          break;
        case "RightAngledTriangle":
        case "IsoscelesTriangle":
          html = `
            <input type="number" class="param-1" placeholder="Base" value="30" style="width: 70px;">
            <input type="number" class="param-2" placeholder="Height" value="40" style="width: 70px;">
          `;
          break;
        case "RegularHexagon":
          html = `<input type="number" class="param-1" placeholder="SideLength" value="30" style="width: 90px;">`;
          break;
        case "Ellipse":
          html = `
            <input type="number" class="param-1" placeholder="MajorAxis" value="50" style="width: 80px;">
            <input type="number" class="param-2" placeholder="MinorAxis" value="30" style="width: 80px;">
          `;
          break;
      }
      container.innerHTML = html;
    }

    // 3. Thêm chi tiết mới
    function addPartRow() {
      const container = document.getElementById("partsList");
      const row = document.createElement("div");
      row.className = "item-row part-input-item";
      row.innerHTML = `
        <select class="input-shape" onchange="changeShapeInputs(this)">
          <option value="Rectangle" selected>Rectangle</option>
          <option value="Circle">Circle</option>
          <option value="RightAngledTriangle">RightAngledTriangle</option>
          <option value="IsoscelesTriangle">IsoscelesTriangle</option>
          <option value="RegularHexagon">RegularHexagon</option>
          <option value="Ellipse">Ellipse</option>
        </select>
        <div class="param-fields">
          <input type="number" class="param-1" placeholder="Width" value="100" style="width: 70px;">
          <input type="number" class="param-2" placeholder="Height" value="50" style="width: 70px;">
        </div>
        <input type="number" class="input-qty part-qty" placeholder="SL" value="1" title="Số lượng">
        <button class="btn-del" onclick="removeItemRow(this, 'partsList')">×</button>
      `;
      container.appendChild(row);
    }

    // 4. Xóa dòng
    function removeItemRow(btn, containerId) {
      const rows = document.getElementById(containerId).children;
      if (rows.length > 1) {
        btn.parentElement.remove();
      } else {
        alert("Cần giữ lại ít nhất 1 dòng!");
      }
    }

    // 5. Chuẩn bị Payload, in JSON ra kiểm tra và gửi API
async function callApi() {
  // A. Gom danh sách tấm phôi
  const sheetRows = document.querySelectorAll(".sheet-input-item");
  const stockSheets = [];

  sheetRows.forEach(row => {
    const w = parseFloat(row.querySelector(".sheet-w").value) || 0;
    const h = parseFloat(row.querySelector(".sheet-h").value) || 0;
    const qty = parseInt(row.querySelector(".sheet-qty").value) || 1;

    for (let i = 0; i < qty; i++) {
      stockSheets.push({
        width: w,
        height: h
      });
    }
  });

  // B. Gom danh sách chi tiết cắt theo đúng cấu trúc của CuttingPackParser
  const partRows = document.querySelectorAll(".part-input-item");
  const partsGroup = [];

  partRows.forEach(row => {
    const shape = row.querySelector(".input-shape").value;
    const p1 = parseFloat(row.querySelector(".param-1")?.value) || 0;
    const p2 = parseFloat(row.querySelector(".param-2")?.value) || 0;
    const qty = parseInt(row.querySelector(".part-qty").value) || 1;

    for (let i = 0; i < qty; i++) {
      let itemObj = { ShapeName: shape };
      switch (shape) {
        case "Rectangle":
          itemObj.Width = p1;
          itemObj.Height = p2;
          break;
        case "Circle":
          itemObj.Radius = p1;
          break;
        case "RightAngledTriangle":
        case "IsoscelesTriangle":
          itemObj.Base = p1;
          itemObj.Height = p2;
          break;
        case "RegularHexagon":
          itemObj.SideLength = p1;
          break;
        case "Ellipse":
          itemObj.MajorAxis = p1;
          itemObj.MinorAxis = p2;
          break;
      }
      partsGroup.push(itemObj);
    }
  });

  // C. Đóng gói JSON payload
  const payload = {
    stockSheets: stockSheets,
    cuttingPack: [
      JSON.stringify(partsGroup) // Đúng chuỗi JSON lồng theo format yêu cầu
    ]
  };

  const jsonString = JSON.stringify(payload, null, 2);

  // ⚡ IN JSON RA CONSOLE NGAY KHI BẤM NÚT
  console.log("==================== [PAYLOAD GỬI LÊN BE] ====================");
  console.log(jsonString);
  console.log("=============================================================");

  try {
    const res = await fetch("https://localhost:7187/CalculateLayout", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (!res.ok) throw new Error(`Lỗi server: ${res.status}`);

    const data = await res.json();
    console.log("Response từ BE:", data);
    renderLayout(data);
  } catch (err) {
    console.error("Lỗi gọi API:", err);
  }
}
    // 6. Vẽ danh sách kết quả lên SVG
    function renderLayout(data) {
      const container = document.getElementById("sheetsContainer");
      container.innerHTML = ""; 

      if (!data.sheets || data.sheets.length === 0) return;

      const originX = 50;  
      const originY = 40;  
      const step = 200; // bước chia to hơn một chút cho đỡ rối mắt   

      data.sheets.forEach(sheet => {
        const card = document.createElement("div");
        card.className = "sheet-card";

        const title = document.createElement("div");
        title.style.cssText = "font-weight: bold; margin-bottom: 10px; color: #1976d2;";
        title.innerText = `Tấm #${sheet.sheetId} (${sheet.width} × ${sheet.height})`;
        card.appendChild(title);

        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("width", sheet.width + originX + 50);
        svg.setAttribute("height", sheet.height + originY + 50);

        let content = "";

        // Trục X & Vạch chia
        for (let x = 0; x <= sheet.width; x += step) {
          let posX = originX + x;
          content += `<line x1="${posX}" y1="${originY - 5}" x2="${posX}" y2="${originY + sheet.height}" class="grid-line" />`;
          content += `<text x="${posX}" y="${originY - 8}" text-anchor="middle" class="tick-text">${x}</text>`;
        }

        // Trục Y & Vạch chia
        for (let y = 0; y <= sheet.height; y += step) {
          let posY = originY + y;
          content += `<line x1="${originX - 5}" y1="${posY}" x2="${originX + sheet.width}" y2="${posY}" class="grid-line" />`;
          content += `<text x="${originX - 8}" y="${posY + 4}" text-anchor="end" class="tick-text">${y}</text>`;
        }

        // Trục chính
        content += `<line x1="${originX}" y1="${originY}" x2="${originX + sheet.width}" y2="${originY}" class="axis" />`;
        content += `<line x1="${originX}" y1="${originY}" x2="${originX + sheet.height}" y2="${originY}" class="axis" />`;

        // Tấm phôi nguyên
        content += `<rect x="${originX}" y="${originY}" width="${sheet.width}" height="${sheet.height}" class="stock-sheet" />`;

        // Các chi tiết đã xếp
        if (sheet.placedParts) {
          sheet.placedParts.forEach(part => {
            let rx = originX + part.x;
            let ry = originY + part.y;
            content += `
              <g>
                <rect x="${rx}" y="${ry}" width="${part.width}" height="${part.height}" class="part-rect">
                  <title>${part.name}: [${part.width} x ${part.height}] tại (${part.x}, ${part.y}) ${part.isRotated ? '- Xoay 90°' : ''}</title>
                </rect>
                <text x="${rx + part.width / 2}" y="${ry + part.height / 2}" 
                      text-anchor="middle" dominant-baseline="middle" 
                      class="part-label">
                  ${part.name}
                </text>
              </g>
            `;
          });
        }

        svg.innerHTML = content;
        card.appendChild(svg);
        container.appendChild(card);
      });
    }

    // Mẫu ban đầu hiển thị thử nghiệm
    renderLayout({
      sheets: [{
        sheetId: 1,
        width: 1000,
        height: 2000,
        placedParts: [
          { id: 1, name: "P1", x: 10, y: 10, width: 200, height: 100, isRotated: false },
          { id: 2, name: "P2", x: 220, y: 10, width: 150, height: 300, isRotated: true }
        ]
      }]
    });
  </script>
</body>
</html>
